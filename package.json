{
  "name": "tenant-mcp-gateway",
  "version": "1.0.0",
  "private": true,
  "description": "Tenant-isolated stdio to SSE MCP gateway template",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": { "bun": ">=1.3.14" },
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test ./test",
    "check": "bun run typecheck && bun run test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.0"
  }
}
