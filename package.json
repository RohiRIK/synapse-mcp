{
  "name": "tenant-mcp-gateway",
  "version": "1.0.0",
  "private": true,
  "description": "Tenant-isolated stdio to SSE MCP gateway template",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": { "node": ">=22.14.0", "bun": ">=1.3.14" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "bun run build && node --import tsx --test test/*.test.ts",
    "check": "bun run test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
