{
  "name": "tenant-mcp-gateway",
  "version": "1.0.0",
  "private": true,
  "description": "Tenant-isolated stdio to SSE MCP gateway template",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test ./test",
    "check": "bun run typecheck && bun run test"
  },
  "dependencies": {
    "@azure/msal-node": "^7.2.3",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "typescript": "^5.9.3"
  }
}
